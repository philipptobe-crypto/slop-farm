local function ser(v)
    if typeof(v) == "CFrame" then return {t = "cf", c = {v:GetComponents()}} end
    if typeof(v) == "Vector3" then return {t = "v3", x = v.X, y = v.Y, z = v.Z} end
    if type(v) == "table" then local t = {} for k, x in pairs(v) do t[k] = ser(x) end return t end
    if type(v) == "number" or type(v) == "string" or type(v) == "boolean" then return v end
    return nil
end
local function de(v)
    if type(v) == "table" and v.t == "cf" then return CFrame.new(unpack(v.c)) end
    if type(v) == "table" and v.t == "v3" then return Vector3.new(v.x, v.y, v.z) end
    if type(v) == "table" and v.t == nil then local t = {} for k, x in pairs(v) do t[k] = de(x) end return t end
    return v
end

