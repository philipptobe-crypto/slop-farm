local function getCash()
    local c = LP:FindFirstChild("Cash")
    if c and tonumber(c.Value) then return tonumber(c.Value) end
    return 0
end
local function isOwn(m)
    if typeof(m) ~= "Instance" then return false end
    local f = WS:FindFirstChild("Towers")
    if not f then return false end
    local inside = false
    pcall(function() inside = m:IsDescendantOf(f) end)
    if not inside and m.Parent ~= f then return false end
    local val = nil
    pcall(function()
        local cfg = m:FindFirstChild("Config", true)
        if cfg then local o = cfg:FindFirstChild("Owner", true) if o and o.Value ~= nil then val = o.Value return end end
        val = m:GetAttribute("Owner")
    end)
    if val == nil then return false end
    local n = typeof(val) == "Instance" and val.Name or tostring(val)
    return n == LP.Name
end
local function getPv(m)
    local ok, pv = pcall(function() return m:GetPivot() end)
    if ok then return pv end
    return nil
end

