local function IsInGame()
    if not WS:FindFirstChild("Towers") then return false end
    if not RS:FindFirstChild("Functions") then return false end
    if not LP.PlayerGui:FindFirstChild("GameGui") then return false end
    return true
end

local function listFiles()
    local out = {}
    pcall(function()
        for _, f in ipairs(listfiles(FOLDER)) do
            local b = tostring(f):match("([^/\\]+)%.json$")
            if b and b:sub(1, 4) ~= "acc_" then table.insert(out, b) end
        end
    end)
    table.sort(out)
    if #out == 0 then return {"keine files"} end
    return out
end
local function curFile()
