local Placing = false
local function runPlacer(filename)
    if Placing then return end
    if not Spawn then note("Placer", "SpawnTower fehlt") return end
    local ok, content = pcall(function() return readfile(FOLDER .. "/" .. tostring(filename) .. ".json") end)
    if not ok then note("Placer", "file fehlt") return end
    local data = HS:JSONDecode(content)
    local acts = data.Actions or data
    table.sort(acts, function(a, b) return (a.Elapsed or 0) < (b.Elapsed or 0) end)
    Placing = true
    local start = os.clock()
    local idx = 1
    local placed = 0
    note("Placer", "start " .. tostring(filename))
    while Cfg.AutoPlace and idx <= #acts do
        local e = acts[idx]
        local ready = Cfg.IgnoreTime
        if not ready then ready = (os.clock() - start) >= (e.Elapsed or 0) end
        if ready then
            local need = tonumber(e.Price) or 0
            if getCash() >= need then
                local args = {e.Unit, de(e.Args[2]), false}
                local before = {}
                local f = WS:FindFirstChild("Towers")
                if f then for _, m in ipairs(f:GetChildren()) do before[m] = true end end
                pcall(function() Spawn:InvokeServer(unpack(args)) end)
                local t1 = os.clock()
                local live = nil
                while os.clock() - t1 < 2.5 do
                    local ff = WS:FindFirstChild("Towers")
                    if ff then
                        for _, m in ipairs(ff:GetChildren()) do
                            if not before[m] and m.Name == e.Unit and isOwn(m) then live = m break end
                        end
                    end
                    if live then break end
                    task.wait(0.2)
                end
                if live then placed = placed + 1 idx = idx + 1 else task.wait(1) end
            else task.wait(0.5) end
        else task.wait(0.2) end
    end
    Placing = false
    note("Placer", "fertig " .. tostring(placed))
end

